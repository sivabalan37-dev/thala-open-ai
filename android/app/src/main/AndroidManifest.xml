<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone: to hear you -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Contacts + calling: "call amma" -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Timers and alarms without opening the Clock app -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Internet: only for the optional Firebase cloud (saving your chats) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ only lets an app see other apps if it asks here -->
    <queries>
        <!-- every app that has a launcher icon (so Thala can open them) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- the phone's speech recognizer -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- the phone's text-to-speech engine -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="Thala"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
